int* schit(size_t n) 
{
    std::cin >> n;
    if (!(std::cin) || n <= 0){
        throw std::invalid_argument("Invalid size input.");
    }

    int* arr = new int[n];

    for (int i = 0; i < n; ++i){
        std::cin >> arr[i];
        if (!(std::cin)){
            delete[] arr;
            throw std::invalid_argument("Invalid array input.");
        }
    }
    return arr;
}

long long sumOfElements(int* arr, int size){ 
    long long sum = 0;
    long long value = 0;
    if (!arr || size <= 0)
    {
    throw std::invalid_argument("Invalid array or size.");
    return 1;
    }
    constexpr long long max = std::numeric_limits<long long>::max();
    constexpr long long min = std::numeric_limits<long long>::min();
    for (int i = 0; i < size; ++i)
    {
    
    value = arr[i];

    if (value > 0 && sum > max - value) {
    throw std::overflow_error("Overflow occurred during summation.");
    return 2;
    }
    if (value < 0 && sum < min - value) {
    throw std::underflow_error("Underflow occurred during summation.");
    return 2;
    }
    sum += value;
    }
    return sum;
    }

